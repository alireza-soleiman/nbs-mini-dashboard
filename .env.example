# Template for .env. Copy it and put real values in the copy:
#   Copy-Item .env.example .env
# .env is ignored by Git (it holds secrets); this template is committed.

# --- PostGIS database (used by the db service and by Django) ---
POSTGRES_DB=nbs
POSTGRES_USER=nbs
POSTGRES_PASSWORD=change-me
# Port on your PC, for tools like QGIS, pgAdmin or psql. 5432 is the PostgreSQL
# default; 5433 avoids a clash with a PostgreSQL already installed on Windows.
# Django does not use it: inside Docker it talks to db:5432.
POSTGRES_HOST_PORT=5433

# --- Django ---
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(40))"
DJANGO_SECRET_KEY=change-me
# 1 = debug mode with detailed error pages (development only, never on a server)
DJANGO_DEBUG=1
# Comma-separated host names Django answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Log level for the console (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO

# --- Only on a real server with HTTPS (see README, "Running it like on a server") ---
# 1 = redirect to https, secure cookies, HSTS. Keep 0 on your PC (http://localhost).
DJANGO_HTTPS=0
# How long browsers remember "HTTPS only" (seconds). Start with 3600, later 31536000.
DJANGO_HSTS_SECONDS=3600
# Full addresses allowed to send forms (the admin login), e.g. https://nbs.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Local admin account for http://localhost:8000/admin/ ---
# Created with: docker compose exec web python manage.py createsuperuser --noinput
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
