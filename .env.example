# Template for .env. Copy it and put real values in the copy:
#   Copy-Item .env.example .env
# .env is ignored by Git (it holds secrets); this template is committed.

# PostGIS database (used by compose.yaml, later also by Django)
POSTGRES_DB=nbs
POSTGRES_USER=nbs
POSTGRES_PASSWORD=change-me
# Port on your PC. 5432 is the PostgreSQL default; 5433 avoids a clash
# with a PostgreSQL that is already installed on Windows.
POSTGRES_PORT=5433
