# Template for .env. Copy it and put real values in the copy:
#   Copy-Item .env.example .env
# .env is ignored by Git (it holds secrets); this template is committed.

# --- PostGIS database (used by the db service and by Django) ---
POSTGRES_DB=nbs
POSTGRES_USER=nbs
POSTGRES_PASSWORD=change-me
# Port on your PC, for tools like QGIS, pgAdmin or psql. 5432 is the PostgreSQL
# default; 5433 avoids a clash with a PostgreSQL already installed on Windows.
# Django does not use it: inside Docker it talks to db:5432.
POSTGRES_HOST_PORT=5433

# --- Django ---
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(40))"
DJANGO_SECRET_KEY=change-me
# 1 = debug mode with detailed error pages (development only, never on a server)
DJANGO_DEBUG=1
# Comma-separated host names Django answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
